# Examly backend configuration template.
# Copy to `.env` (gitignored) and adjust. Precedence: process env > .env file > defaults.
# API keys are NEVER written in code - they are read from key files or env vars.

# --- OmniRoute: local OpenAI-compatible gateway (primary) ---
OMNI_KEY_FILE=/path/to/omniroute_apikey.txt
OMNI_BASE_URL=http://localhost:20128/v1
OMNI_MODEL=free-fast
# OMNI_API_KEY=...             # alternatively provide the key directly as an env var

# --- Grok (xAI): primary answer generator ---
GROK_KEY_FILE=/path/to/grok_api_key.txt
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast
# GROK_API_KEY=xai-...        # alternatively provide the key directly as an env var

# --- Gemini: fallback answer generator ---
GEMINI_KEY_FILE=/path/to/gemini_apikey.txt
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash   # comma list: models tried in order
# GEMINI_API_KEY=...          # alternatively provide the key directly as an env var

# --- Behaviour ---
LLM_PROVIDER_ORDER=omni,grok,gemini   # comma-separated chain, tried in order
LLM_TIMEOUT_S=30                 # seconds per request (5-120)
LLM_TOTAL_S=45                   # hard budget for the whole chain (10-300)
MAX_UPLOAD_MB=25                 # per-file upload limit (1-1024)
# EXAMLY_DISABLE_LLM=1          # force extractive answers (no LLM calls)

# --- Legacy / misc (still supported) ---
# EXAMLY_LLM_URL=...  EXAMLY_LLM_KEY=...  EXAMLY_LLM_MODEL=...   # extra OpenAI-compatible provider, tried first
# EXAMLY_DB=/path/to/examly.db      # sqlite path
# EXAMLY_ENV_FILE=/path/to/.env     # alternative env file location
# EXAMLY_TODAY=YYYY-MM-DD           # override date (tests)
